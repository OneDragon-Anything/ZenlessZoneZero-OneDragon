<ui:FluentWindow x:Class="OneDragonLauncherWpf.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="运行终端日志 (Console Output)" Width="580" Height="420" MinWidth="480" MinHeight="300"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round" WindowBackdropType="None"
        Background="{DynamicResource LauncherBackgroundBrush}" Icon="Assets/logo-full.ico"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource LauncherBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="运行终端日志 (Console Output)" Height="36" FontSize="14" FontWeight="SemiBold"
                     ApplicationTheme="{DynamicResource LauncherTitleBarTheme}"
                     ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}"
                     ShowMinimize="False" ShowMaximize="False" CanMaximize="False" ForceShutdown="False">
            <ui:TitleBar.Icon>
                <ui:FontIcon Glyph="&gt;_" FontFamily="Consolas" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1" Margin="16,6,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource LauncherLogBrush}" BorderBrush="{DynamicResource LauncherBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="LogText" Style="{x:Null}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Padding="13,10"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="Transparent"
                         BorderThickness="0" IsUndoEnabled="False" AutomationProperties.Name="运行日志" />
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CopyButton" Content="复制日志" Width="110" Margin="0,0,8,0"
                           Style="{StaticResource LauncherButton}" Click="CopyLog_Click" />
                <ui:Button Content="关闭" Appearance="Primary" Width="80"
                           Style="{StaticResource LauncherButton}" Click="CloseLog_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
