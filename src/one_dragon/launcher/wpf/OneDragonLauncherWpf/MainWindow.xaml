<ui:FluentWindow x:Class="OneDragonLauncherWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="绝区零一条龙启动器" Width="520" Height="300" MinWidth="520" MaxWidth="520" MinHeight="300" MaxHeight="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round"
        WindowBackdropType="None" Background="{DynamicResource LauncherBackgroundBrush}"
        Icon="Assets/logo-full.ico" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource LauncherBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Height="36" Title="" ShowMinimize="False"
                     ApplicationTheme="{DynamicResource LauncherTitleBarTheme}"
                     ButtonsForeground="{DynamicResource TextFillColorPrimaryBrush}"
                     ShowMaximize="False" CanMaximize="False" ForceShutdown="False" />
        <Grid Grid.Row="1" Margin="36,24,36,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="8" />
                <RowDefinition Height="30" />
                <RowDefinition Height="8" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="18" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <Image Source="Assets/logo.png" Width="68" Height="68"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Grid.Row="2" Text="绝区零一条龙" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" FontSize="14"
                       Foreground="{DynamicResource LauncherMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ProgressBar x:Name="StartupProgressBar" Grid.Row="6" Minimum="0" Maximum="100" Height="4"
                         Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                         AutomationProperties.Name="启动进度">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                        <Setter Property="IsIndeterminate" Value="True" />
                        <Setter Property="Value" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                <Setter Property="IsIndeterminate" Value="False" />
                                <Setter Property="Value" Value="100" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StepText}" ToolTip="{Binding StepText}" FontSize="12"
                           Foreground="{DynamicResource LauncherMutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <ui:Button Grid.Column="2" Content="查看日志" Appearance="Primary"
                           MinWidth="88" HorizontalAlignment="Right"
                           Style="{StaticResource LauncherButton}" Click="OpenLog_Click" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
